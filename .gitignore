# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Env / secrets — never commit
.env
.env.*
!.env.example

# Node / dashboard
node_modules/
dashboard/.next/
dashboard/out/

# Local data / dumps
*.dump.zst
*.dump
/var/backups/
/backups/
logs/

# Derived corpora — regenerate, never commit.
# briefs/ renders from Postgres via scripts/export_briefs.py (~40s for the full slice).
# graphify-out/ is the graph build; its reasoned edges live in entity_semantic_edges (0009).
# GRAPH_REPORT.md is the exception — small, human-readable, worth keeping in history.
briefs/
graphify-out/*
!graphify-out/GRAPH_REPORT.md
