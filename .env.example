# Copy to .env for local dev. Never commit .env. Server uses /etc/seismograph/env (doc 12).
SEISMO_DATABASE_URL=postgresql+psycopg://seismo:seismo@localhost:5432/seismograph

# LLM provider: mock (default, $0) | ollama (local, $0) | anthropic (prod)
SEISMO_LLM_PROVIDER=mock
SEISMO_OLLAMA_HOST=http://localhost:11434
SEISMO_OLLAMA_MODEL=qwen2.5:7b-instruct
# SEISMO_ANTHROPIC_API_KEY=sk-ant-...
# SEISMO_MODEL_LIVE=claude-sonnet-...
# SEISMO_MODEL_HINDCAST=claude-sonnet-...

# Source credentials (optional; improve rate limits & unlock GitHub Discussions/HF gated reads)
# SEISMO_GITHUB_TOKEN=
# SEISMO_HF_TOKEN=

# Community research (doc 15) — sources: github (issues+discussions), hf (model discussions), hn
# The cross-source community verdict can run on its own provider/model, so the discussion
# summarizer uses a paid model while comprehension cards stay on local ollama. Both fall back
# to SEISMO_LLM_PROVIDER / SEISMO_MODEL_LIVE when unset.
#   anthropic  — the API. ~$0.004/entity, needs API credit (separate from a Claude subscription).
#   claude_cli — headless `claude -p`, billed to the Claude Code subscription instead of credit.
#                ~10x the tokens (each call carries Claude Code's own ~24k-token scaffolding) and
#                ~10x slower, but needs no credit. Set SEISMO_CLAUDE_CLI_BIN to an absolute path
#                if anything runs under launchd/cron, which do not inherit an interactive PATH.
# SEISMO_COMMUNITY_LLM_PROVIDER=claude_cli
# SEISMO_COMMUNITY_MODEL=claude-haiku-4-5
# SEISMO_CLAUDE_CLI_BIN=/usr/local/bin/claude
SEISMO_COMMUNITY_RESEARCH_DAILY_LIMIT=200
SEISMO_COMMUNITY_MAX_THREADS_PER_ENTITY=5
SEISMO_COMMUNITY_MAX_COMMENTS_PER_THREAD=20
SEISMO_COMMUNITY_SEARCH_QUERIES_PER_ENTITY=5
